<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>me.sjun.AnalogAudio.broker</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/PrivilegedHelperTools/me.sjun.AnalogAudio.broker</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>me.sjun.AnalogAudio.broker</key>
		<true/>
	</dict>
	<!-- Stay up, so the driver and the app keep sharing one region. -->
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>UserName</key>
	<string>nobody</string>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
